<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══ Industry design tokens ═══ -->

    <Color x:Key="BgColor">#F2F2F3</Color>
    <Color x:Key="SurfaceColor">#E9E9EA</Color>
    <Color x:Key="TextColor">#1D1F20</Color>
    <Color x:Key="AccentColor">#5980A6</Color>

    <SolidColorBrush x:Key="BgBrush" Color="#F2F2F3" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#E9E9EA" />
    <SolidColorBrush x:Key="TextBrush" Color="#1D1F20" />
    <SolidColorBrush x:Key="AccentBrush" Color="#5980A6" />

    <!-- divider = text @16% -->
    <SolidColorBrush x:Key="DividerBrush" Color="#291D1F20" />
    <!-- text tints -->
    <SolidColorBrush x:Key="Text75Brush" Color="#BF1D1F20" />
    <SolidColorBrush x:Key="Text65Brush" Color="#A61D1F20" />
    <SolidColorBrush x:Key="Text60Brush" Color="#991D1F20" />
    <SolidColorBrush x:Key="Text55Brush" Color="#8C1D1F20" />
    <SolidColorBrush x:Key="Text50Brush" Color="#801D1F20" />
    <SolidColorBrush x:Key="Text45Brush" Color="#731D1F20" />
    <SolidColorBrush x:Key="Text40Brush" Color="#661D1F20" />
    <SolidColorBrush x:Key="Text35Brush" Color="#591D1F20" />
    <SolidColorBrush x:Key="Text14Brush" Color="#241D1F20" />
    <SolidColorBrush x:Key="Text08Brush" Color="#141D1F20" />
    <SolidColorBrush x:Key="Text07Brush" Color="#121D1F20" />
    <SolidColorBrush x:Key="Text05Brush" Color="#0D1D1F20" />
    <SolidColorBrush x:Key="CornerMarkBrush" Color="#8C1D1F20" />
    <!-- accent tints -->
    <SolidColorBrush x:Key="AccentTint08Brush" Color="#145980A6" />
    <SolidColorBrush x:Key="AccentTint10Brush" Color="#1A5980A6" />
    <SolidColorBrush x:Key="AccentTint18Brush" Color="#2E5980A6" />

    <!-- accent ramp -->
    <SolidColorBrush x:Key="Accent100Brush" Color="#EEF6FF" />
    <SolidColorBrush x:Key="Accent200Brush" Color="#D6EBFF" />
    <SolidColorBrush x:Key="Accent300Brush" Color="#B5D9FD" />
    <SolidColorBrush x:Key="Accent400Brush" Color="#94BCE3" />
    <SolidColorBrush x:Key="Accent500Brush" Color="#749DC4" />
    <SolidColorBrush x:Key="Accent600Brush" Color="#597EA3" />
    <SolidColorBrush x:Key="Accent700Brush" Color="#416180" />
    <SolidColorBrush x:Key="Accent800Brush" Color="#2C455D" />
    <SolidColorBrush x:Key="Accent900Brush" Color="#1D2D3D" />

    <!-- neutral ramp -->
    <SolidColorBrush x:Key="Neutral100Brush" Color="#F5F5F8" />
    <SolidColorBrush x:Key="Neutral200Brush" Color="#E7E7EA" />
    <SolidColorBrush x:Key="Neutral300Brush" Color="#D4D4D7" />
    <SolidColorBrush x:Key="Neutral400Brush" Color="#B7B7BA" />
    <SolidColorBrush x:Key="Neutral500Brush" Color="#98989B" />
    <SolidColorBrush x:Key="Neutral600Brush" Color="#7A7A7D" />
    <SolidColorBrush x:Key="Neutral700Brush" Color="#5D5D60" />
    <SolidColorBrush x:Key="Neutral800Brush" Color="#424244" />
    <SolidColorBrush x:Key="Neutral900Brush" Color="#2B2B2D" />

    <!-- Barlow ships embedded (OFL, see Fonts/OFL-*.txt); Segoe UI is the safety net.
         The stretches live in separate folders because DirectWrite groups both under
         the WWS family "Barlow", and a mixed folder makes face selection ambiguous. -->
    <FontFamily x:Key="HeadingFont">pack://application:,,,/Fonts/BarlowCondensed/#Barlow, Segoe UI</FontFamily>
    <FontFamily x:Key="BodyFont">pack://application:,,,/Fonts/Barlow/#Barlow, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

    <!-- ═══ Focus visual: 2px accent outline, 2px offset ═══ -->

    <Style x:Key="IndustryFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3"
                               Stroke="{StaticResource AccentBrush}"
                               StrokeThickness="2"
                               SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ Text styles ═══ -->

    <Style x:Key="Kicker" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="Foreground" Value="{StaticResource Text55Brush}" />
    </Style>

    <Style x:Key="ColumnKicker" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="Foreground" Value="{StaticResource Text60Brush}" />
    </Style>

    <Style x:Key="SectionKicker" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="Foreground" Value="{StaticResource Accent700Brush}" />
    </Style>

    <Style x:Key="MonoText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- ═══ Blueprint frame: square, hairline border, "+" registration marks ═══ -->

    <Style x:Key="CornerMark" TargetType="Path">
        <Setter Property="Data" Value="M5.5,0 L5.5,11 M0,5.5 L11,5.5" />
        <Setter Property="Stroke" Value="{StaticResource CornerMarkBrush}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Width" Value="11" />
        <Setter Property="Height" Value="11" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <Style x:Key="BlueprintPanel" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource DividerBrush}"
                                BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <Path Style="{StaticResource CornerMark}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-5,-5,0,0" />
                        <Path Style="{StaticResource CornerMark}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-5,-5,0" />
                        <Path Style="{StaticResource CornerMark}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-5,0,0,-5" />
                        <Path Style="{StaticResource CornerMark}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-5,-5" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ Buttons ═══ -->

    <Style x:Key="ButtonBase" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource HeadingFont}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource IndustryFocusVisual}" />
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Foreground" Value="{StaticResource BgBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root">
                        <Border x:Name="Bd"
                                Background="{StaticResource AccentBrush}"
                                BorderBrush="{StaticResource AccentBrush}"
                                BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Border>
                        <Path Style="{StaticResource CornerMark}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-5,-5,0,0" />
                        <Path Style="{StaticResource CornerMark}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-5,-5,0" />
                        <Path Style="{StaticResource CornerMark}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-5,0,0,-5" />
                        <Path Style="{StaticResource CornerMark}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-5,-5" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Accent600Brush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Accent700Brush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="SecondaryButtonTemplate" TargetType="Button">
        <Grid x:Name="Root">
            <Border x:Name="Bd"
                    Background="Transparent"
                    BorderBrush="{StaticResource DividerBrush}"
                    BorderThickness="1"
                    Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
            </Border>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Text07Brush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Text14Brush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Root" Property="Opacity" Value="0.45" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Template" Value="{StaticResource SecondaryButtonTemplate}" />
    </Style>

    <Style x:Key="SecondaryBlueprintButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                BorderBrush="{StaticResource DividerBrush}"
                                BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Border>
                        <Path Style="{StaticResource CornerMark}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-5,-5,0,0" />
                        <Path Style="{StaticResource CornerMark}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-5,-5,0" />
                        <Path Style="{StaticResource CornerMark}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-5,0,0,-5" />
                        <Path Style="{StaticResource CornerMark}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-5,-5" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Text07Brush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Text14Brush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        <Setter Property="Padding" Value="6,5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentTint10Brush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentTint18Brush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GhostIconButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- Details-pane action button: solid accent while its action is available, quiet otherwise. -->
    <Style x:Key="ContextActionButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Foreground" Value="{StaticResource BgBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root">
                        <Border x:Name="Bd"
                                Background="{StaticResource AccentBrush}"
                                BorderBrush="{StaticResource AccentBrush}"
                                BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Border>
                        <Grid x:Name="Marks">
                            <Path Style="{StaticResource CornerMark}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-5,-5,0,0" />
                            <Path Style="{StaticResource CornerMark}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-5,-5,0" />
                            <Path Style="{StaticResource CornerMark}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-5,0,0,-5" />
                            <Path Style="{StaticResource CornerMark}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-5,-5" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Accent600Brush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Accent700Brush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                            <Setter TargetName="Bd" Property="Background" Value="Transparent" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource DividerBrush}" />
                            <Setter TargetName="Marks" Property="Visibility" Value="Collapsed" />
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SecondaryActionButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Padding" Value="8,4" />
    </Style>

    <!-- ═══ Inputs ═══ -->

    <Style x:Key="IndustryTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="SelectionBrush" Value="{StaticResource Accent300Brush}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource Text45Brush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="IndustryComboBoxItem" TargetType="ComboBoxItem">
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource IndustryFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Accent100Brush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Accent100Brush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="IndustryComboBox" TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource IndustryFocusVisual}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource IndustryComboBoxItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="ToggleButton"
                                      Focusable="False"
                                      ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bd"
                                            Background="{StaticResource SurfaceBrush}"
                                            BorderBrush="{StaticResource DividerBrush}"
                                            BorderThickness="1">
                                        <Path HorizontalAlignment="Right"
                                              VerticalAlignment="Center"
                                              Margin="0,0,10,0"
                                              Data="M0,0 L4,4 L8,0"
                                              Stroke="{StaticResource Text55Brush}"
                                              StrokeThickness="1.5" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Text45Brush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          Margin="10,0,26,0"
                                          VerticalAlignment="Center"
                                          IsHitTestVisible="False" />
                        <Popup x:Name="PART_Popup"
                               Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True"
                               Focusable="False">
                            <Border Background="{StaticResource BgBrush}"
                                    BorderBrush="{StaticResource DividerBrush}"
                                    BorderThickness="1"
                                    MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Margin="0,2,0,0">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="ToggleButton" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="IndustryCheckBox" TargetType="CheckBox">
        <Setter Property="FocusVisualStyle" Value="{StaticResource IndustryFocusVisual}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Border x:Name="Box"
                                Width="14"
                                Height="14"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource Text45Brush}"
                                BorderThickness="1"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center">
                            <Path x:Name="Check"
                                  Data="M2,6.5 L5,9.5 L10.5,3"
                                  Stroke="{StaticResource BgBrush}"
                                  StrokeThickness="1.6"
                                  Visibility="Collapsed" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ Slim scrollbars ═══ -->

    <ControlTemplate x:Key="SlimScrollBarVertical" TargetType="ScrollBar">
        <Grid Background="Transparent">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Focusable="False">
                        <Thumb.Template>
                            <ControlTemplate TargetType="Thumb">
                                <Border Background="#381D1F20" Margin="3,0,2,0" CornerRadius="2.5" />
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                </Track.Thumb>
            </Track>
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="SlimScrollBarHorizontal" TargetType="ScrollBar">
        <Grid Background="Transparent">
            <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" Focusable="False" />
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" Focusable="False" />
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Focusable="False">
                        <Thumb.Template>
                            <ControlTemplate TargetType="Thumb">
                                <Border Background="#381D1F20" Margin="0,3,0,2" CornerRadius="2.5" />
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                </Track.Thumb>
            </Track>
        </Grid>
    </ControlTemplate>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="10" />
        <Setter Property="Template" Value="{StaticResource SlimScrollBarVertical}" />
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Height" Value="10" />
                <Setter Property="Template" Value="{StaticResource SlimScrollBarHorizontal}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ═══ Filter rail items ═══ -->

    <Style x:Key="FilterRailContainer" TargetType="ListBoxItem">
        <Setter Property="FocusVisualStyle" Value="{StaticResource IndustryFocusVisual}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent" Padding="10,7">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Text05Brush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Accent100Brush}" />
                            <Setter Property="TextElement.FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ Skill list rows ═══ -->

    <Style x:Key="SkillRowContainer" TargetType="ListBoxItem">
        <Setter Property="FocusVisualStyle" Value="{StaticResource IndustryFocusVisual}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd"
                            Background="Transparent"
                            BorderBrush="{StaticResource Text08Brush}"
                            BorderThickness="0,0,0,1"
                            Padding="14,9">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentTint08Brush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Accent100Brush}" />
                        </Trigger>

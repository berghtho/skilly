<Window x:Class="Skilly.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Skilly"
        xmlns:vm="clr-namespace:Skilly.ViewModels"
        Title="Skilly"
        Icon="{StaticResource BrandIcon}"
        Width="1520"
        Height="850"
        MinWidth="920"
        MinHeight="600"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource BodyFont}"
        FontSize="13.5"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        AutomationProperties.Name="Skilly Workbench">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="56"
                      CornerRadius="0"
                      GlassFrameThickness="0,0,0,1"
                      ResizeBorderThickness="6"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="ToolbarGlyph" TargetType="Path">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Stroke" Value="{StaticResource BgBrush}" />
            <Setter Property="StrokeThickness" Value="1.7" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
        </Style>

        <Style x:Key="ToolbarIconButton" TargetType="Button" BasedOn="{StaticResource SteelButton}">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Margin" Value="6,5,0,5" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="300" />
        </Style>

        <Style x:Key="ToolbarIconToggle" TargetType="CheckBox">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Margin" Value="6,5,0,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource IndustryFocusVisual}" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="300" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="{StaticResource Paper35Brush}"
                                BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Paper12Brush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Accent700Brush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent300Brush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Management tag: neutral tint / accent outline / dashed outline -->
        <DataTemplate x:Key="ManagementTag">
            <Grid HorizontalAlignment="Left" VerticalAlignment="Center">
                <Rectangle x:Name="TagBg" RadiusX="3" RadiusY="3" Fill="Transparent" Stroke="Transparent" StrokeThickness="1" />
                <TextBlock x:Name="TagText" Margin="9,3" FontSize="11" Text="{Binding ManagementShort}" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Management}" Value="Managed">
                    <Setter TargetName="TagBg" Property="Fill" Value="{StaticResource Neutral100Brush}" />
                    <Setter TargetName="TagText" Property="Foreground" Value="{StaticResource Neutral800Brush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Management}" Value="Verified Adoption Available">
                    <Setter TargetName="TagBg" Property="Stroke" Value="{StaticResource AccentBrush}" />
                    <Setter TargetName="TagText" Property="Foreground" Value="{StaticResource Accent700Brush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Management}" Value="Unmanaged">
                    <Setter TargetName="TagBg" Property="Stroke" Value="{StaticResource Neutral400Brush}" />
                    <Setter TargetName="TagBg" Property="StrokeDashArray" Value="3 2" />
                    <Setter TargetName="TagText" Property="Foreground" Value="{StaticResource Neutral700Brush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="ManagementTagFull">
            <Grid HorizontalAlignment="Left" VerticalAlignment="Center">
                <Rectangle x:Name="TagBg" RadiusX="3" RadiusY="3" Fill="Transparent" Stroke="Transparent" StrokeThickness="1" />
                <TextBlock x:Name="TagText" Margin="9,3" FontSize="11" Text="{Binding Management}" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Management}" Value="Managed">
                    <Setter TargetName="TagBg" Property="Fill" Value="{StaticResource Neutral100Brush}" />
                    <Setter TargetName="TagText" Property="Foreground" Value="{StaticResource Neutral800Brush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Management}" Value="Verified Adoption Available">
                    <Setter TargetName="TagBg" Property="Stroke" Value="{StaticResource AccentBrush}" />
                    <Setter TargetName="TagText" Property="Foreground" Value="{StaticResource Accent700Brush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Management}" Value="Unmanaged">
                    <Setter TargetName="TagBg" Property="Stroke" Value="{StaticResource Neutral400Brush}" />
                    <Setter TargetName="TagBg" Property="StrokeDashArray" Value="3 2" />
                    <Setter TargetName="TagText" Property="Foreground" Value="{StaticResource Neutral700Brush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="StatusCell">
            <StackPanel VerticalAlignment="Center">
                <Border Background="{StaticResource Accent900Brush}" CornerRadius="3" HorizontalAlignment="Left" Margin="0,1" x:Name="HealthTag" Visibility="Collapsed">
                    <TextBlock Margin="9,3" FontSize="11" Foreground="{StaticResource BgBrush}" Text="{Binding Health}" />
                </Border>
                <Border Background="{StaticResource Accent100Brush}" CornerRadius="3" BorderThickness="1" BorderBrush="Transparent" HorizontalAlignment="Left" Margin="0,1" x:Name="UpdateTag" Visibility="{Binding HasUpdateDeviation, Converter={StaticResource BoolToVisibility}}" ToolTip="{Binding CheckNotice}">
                    <TextBlock Margin="8,2" FontSize="11" Foreground="{StaticResource Accent800Brush}" Text="{Binding StatusUpdateText}" />
                </Border>
                <TextBlock x:Name="Dash" Text="—" Opacity="0.3" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HealthIsHealthy}" Value="False"><Setter TargetName="HealthTag" Property="Visibility" Value="Visible" /></DataTrigger>
                <DataTrigger Binding="{Binding HasStatusDeviation}" Value="True"><Setter TargetName="Dash" Property="Visibility" Value="Collapsed" /></DataTrigger>
                <DataTrigger Binding="{Binding UpdateKind}" Value="Outline">
                    <Setter TargetName="UpdateTag" Property="Background" Value="Transparent" /><Setter TargetName="UpdateTag" Property="BorderBrush" Value="{StaticResource Accent700Brush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="HealthTagDetail">
            <Border x:Name="Tag" Background="{StaticResource Neutral100Brush}" CornerRadius="3" HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock x:Name="TagText" Margin="9,3" FontSize="11" Foreground="{StaticResource Neutral800Brush}" Text="{Binding Health}" />
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HealthIsHealthy}" Value="False">
                    <Setter TargetName="Tag" Property="Background" Value="{StaticResource Accent900Brush}" />
                    <Setter TargetName="TagText" Property="Foreground" Value="{StaticResource BgBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="UpdateTagDetail">
            <Border x:Name="Tag" BorderThickness="1" BorderBrush="Transparent" Background="{StaticResource Neutral100Brush}" CornerRadius="3" HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock x:Name="TagText" Margin="9,3" FontSize="11" Foreground="{StaticResource Neutral700Brush}" Text="{Binding UpdateStatus}" />
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding UpdateKind}" Value="Available">
                    <Setter TargetName="Tag" Property="Background" Value="{StaticResource Accent100Brush}" />
                    <Setter TargetName="TagText" Property="Foreground" Value="{StaticResource Accent800Brush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding UpdateKind}" Value="Outline">
                    <Setter TargetName="Tag" Property="Background" Value="Transparent" />
                    <Setter TargetName="Tag" Property="BorderBrush" Value="{StaticResource Accent700Brush}" />
                    <Setter TargetName="TagText" Property="Foreground" Value="{StaticResource Accent800Brush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Sortable column headers -->
        <Style x:Key="SortHeaderButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Text60Brush}" />
            <Setter Property="FontFamily" Value="{StaticResource HeadingFont}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource IndustryFocusVisual}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="0,1">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DetailLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource Text55Brush}" />
            <Setter Property="Margin" Value="0,0,10,5" />
        </Style>

        <Style x:Key="DetailValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>

        <Style x:Key="DetailValueMono" TargetType="TextBlock" BasedOn="{StaticResource DetailValue}">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style x:Key="SectionHeader" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="0,0,0,4" />
            <Setter Property="Margin" Value="0,18,0,8" />
        </Style>

        <!-- Skill Library header rows are action rows, not selectable inventory rows. -->
        <Style x:Key="LibraryGroupRowContainer" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{StaticResource Text05Brush}"
                                BorderBrush="{StaticResource DividerBrush}"
                                BorderThickness="0,0,0,1">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <local:SkillListContainerStyleSelector x:Key="SkillListContainerSelector"
                                               SkillRowStyle="{StaticResource SkillRowContainer}"
                                               LibraryGroupRowStyle="{StaticResource LibraryGroupRowContainer}" />
    </Window.Resources>

    <Border x:Name="RootShell" SizeChanged="OnShellSizeChanged">
    <DockPanel>
        <!-- ═══ Header bar ═══ -->
        <Border DockPanel.Dock="Top"
                Padding="20,12" Background="{StaticResource Accent900Brush}" TextElement.Foreground="{StaticResource BgBrush}"
                BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel Grid.Row="0" VerticalAlignment="Center" Margin="0,0,18,0">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{StaticResource BrandIcon}" Width="28" Height="28"
                               Margin="0,0,6,0" RenderOptions.BitmapScalingMode="HighQuality"
                               AutomationProperties.Name="Skilly logo" IsHitTestVisible="False" />
                        <TextBlock Text="SKILLY"
                                   FontFamily="{StaticResource HeadingFont}"
                                   FontWeight="SemiBold"
                                   FontSize="24"
                                   LineHeight="24"
                                   LineStackingStrategy="BlockLineHeight" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="SKILL WORKBENCH"
                               FontSize="10"
                               Foreground="{StaticResource Paper60Brush}"
                               Margin="1,3,0,0" />
                </StackPanel>
                <WrapPanel x:Name="HeaderToolbar" Grid.Column="1" Margin="0" VerticalAlignment="Center">
                    <ComboBox x:Name="SourceProviderBox"
                              Style="{StaticResource SteelComboBox}"
                              WindowChrome.IsHitTestVisibleInChrome="True"
                              Width="140"
                              Margin="0,5,0,5"
                              ToolTip="Source provider"
                              ItemsSource="{Binding SourceProviders}"
                              SelectedItem="{Binding SelectedSourceProvider, Mode=TwoWay}"
                              AutomationProperties.Name="Source provider"
                              AutomationProperties.AutomationId="Skilly.SourceProvider"
                              TabIndex="0" />
                    <TextBox x:Name="SourceBox"
                             Style="{StaticResource SteelTextBox}"
                             WindowChrome.IsHitTestVisibleInChrome="True"
                             Width="250"
                             ToolTip="Skill Library URL or reference"
                             Margin="14,5,0,5"
                             FontFamily="{StaticResource MonoFont}"
                             FontSize="12"
                             Text="{Binding SourceText, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Skill source URL or reference"
                             AutomationProperties.AutomationId="Skilly.SourceReference"
                             TabIndex="1" />
                    <Button x:Name="InspectSourceButton"
                            Style="{StaticResource PrimaryButton}" Width="36" Height="36" Padding="8" Margin="14,5,0,5"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            ToolTip="Inspect source (Alt+I)" ToolTipService.ShowOnDisabled="True" ToolTipService.InitialShowDelay="300"
                            IsEnabled="{Binding CanInspectSource}" Click="OnInspectSource"
                            AutomationProperties.Name="Inspect source" AutomationProperties.AcceleratorKey="Alt+I"
                            AutomationProperties.AutomationId="Skilly.InspectSource" TabIndex="2">
                        <Path Style="{StaticResource ToolbarGlyph}" Data="M3,11 A8,8 0 1 0 19,11 A8,8 0 1 0 3,11 M21,21 L16.7,16.7" />
                    </Button>
                    <Button x:Name="RefreshChecksButton" Style="{StaticResource ToolbarIconButton}"
                            Click="OnRefreshChecks" ToolTip="Refresh checks (Alt+R)"
                            AutomationProperties.Name="Refresh checks" AutomationProperties.AcceleratorKey="Alt+R"
                            AutomationProperties.AutomationId="Skilly.RefreshChecks" TabIndex="3">
                        <Path Style="{StaticResource ToolbarGlyph}" Data="M3,12 a9,9 0 0 1 9,-9 a9.75,9.75 0 0 1 6.74,2.74 L21,8 M21,3 v5 h-5 M21,12 a9,9 0 0 1 -9,9 a9.75,9.75 0 0 1 -6.74,-2.74 L3,16 M3,21 v-5 h5" />
                    </Button>
                    <Button x:Name="UpdateAllButton" Style="{StaticResource ToolbarIconButton}"
                            IsEnabled="{Binding CanUpdateAll}" Click="OnUpdateAll"
                            ToolTip="{Binding UpdatableCount, StringFormat=Update all Skills ({0}) - Alt+A}"
                            AutomationProperties.Name="Update all Skills" AutomationProperties.AcceleratorKey="Alt+A"
                            AutomationProperties.AutomationId="Skilly.UpdateAll" TabIndex="4">
                        <Path Style="{StaticResource ToolbarGlyph}" Data="M21,15 v4 a2,2 0 0 1 -2,2 H5 a2,2 0 0 1 -2,-2 v-4 M7,10 l5,5 5,-5 M12,15 V3" />
                    </Button>
                    <Button Style="{StaticResource ToolbarIconButton}" Margin="14,5,0,5"
                            Click="OnShowHistory" ToolTip="Operation history"
                            AutomationProperties.Name="Operation history" AutomationProperties.AutomationId="Skilly.ShowHistory">
                        <Path Style="{StaticResource ToolbarGlyph}" Data="M3,12 A9,9 0 1 0 6,5 M3,3 V8 H8 M12,7 V12 L16,14" />
                    </Button>
                    <Button Style="{StaticResource ToolbarIconButton}" Click="OnExportSkillSet" IsEnabled="{Binding CanExportSet}"
                            ToolTip="Export a Skill set to a ZIP archive"
                            AutomationProperties.Name="Export Skill set" AutomationProperties.AutomationId="Skilly.ExportSet">
                        <Path Style="{StaticResource ToolbarGlyph}" Data="M14,3 H21 V10 M21,3 L11,13 M10,3 H3 V21 H21 V14" />
                    </Button>
                    <Button Style="{StaticResource ToolbarIconButton}" Click="OnImportSkillSet" IsEnabled="{Binding CanShareSets}"
                            ToolTip="Import a Skill set from a ZIP archive"
                            AutomationProperties.Name="Import Skill set" AutomationProperties.AutomationId="Skilly.ImportSet">
                        <Path Style="{StaticResource ToolbarGlyph}" Data="M14,3 H21 V21 H3 V14 M3,3 L13,13 M7,13 H13 V7" />
                    </Button>
                    <CheckBox Style="{StaticResource ToolbarIconToggle}" Margin="14,5,0,5"
                              IsChecked="{Binding ShowDetails, Mode=TwoWay}" ToolTip="Show or hide Skill details"
                              AutomationProperties.Name="Skill details" AutomationProperties.AutomationId="Skilly.ToggleDetails">
                        <Path Style="{StaticResource ToolbarGlyph}" Data="M3,4 H21 V20 H3 Z M14,4 V20 M17,8 H18 M17,12 H18" />
                    </CheckBox>
                    <CheckBox Style="{StaticResource ToolbarIconToggle}" IsChecked="{Binding ReviewUpdatesFirst, Mode=TwoWay}"
                              ToolTip="Review file changes before applying updates"
                              AutomationProperties.Name="Review updates before applying" AutomationProperties.AutomationId="Skilly.ToggleReviewUpdates">
                        <Path Style="{StaticResource ToolbarGlyph}" Data="M14,3 H5 V21 H19 V8 Z M14,3 V8 H19 M8,14 L11,17 L16,12" />
                    </CheckBox>
                </WrapPanel>
                    <Button Grid.Row="0" Grid.Column="2" HorizontalAlignment="Right" x:Name="CloseWindowButton"
                            Style="{StaticResource SteelCloseButton}"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Width="28"
                            Height="28"
                            Margin="14,0,0,0"
                            Click="OnCloseWindow"
                            AutomationProperties.Name="Close Skilly"
                            AutomationProperties.AutomationId="Skilly.CloseWindow">
                        <Viewbox Width="14" Height="14">
                            <Canvas Width="24" Height="24">
                                <Path Data="M18,6 L6,18 M6,6 L18,18"
                                      Stroke="{StaticResource BgBrush}"
                                      StrokeThickness="1.5"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                            </Canvas>
                        </Viewbox>
                    </Button>
            </Grid>
        </Border>

        <!-- ═══ Notice banners ═══ -->
        <Border DockPanel.Dock="Top"
                Padding="20,8"
                Background="{StaticResource Accent800Brush}"
                Visibility="{Binding RecoveryRequired, Converter={StaticResource BoolToVisibility}}"
                AutomationProperties.Name="Recovery Required read-only notice"
                AutomationProperties.AutomationId="Skilly.RecoveryNotice">
            <StackPanel Orientation="Horizontal">
                <Viewbox Width="15" Height="15" Margin="0,0,10,0" VerticalAlignment="Center">
                    <Canvas Width="24" Height="24">
                        <Path Data="M21.73,18 L13.73,4 a2,2 0 0 0 -3.48,0 l-8,14 A2,2 0 0 0 4,21 h16 a2,2 0 0 0 1.73,-3 M12,9 v4 M12,17 h0.01"
                              Stroke="{StaticResource BgBrush}"
                              StrokeThickness="1.5"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round" />
                    </Canvas>
                </Viewbox>
                <TextBlock FontSize="12.5" Foreground="{StaticResource BgBrush}" TextWrapping="Wrap" VerticalAlignment="Center">
                    <Run Text="Recovery Required" FontWeight="Bold" /><Run Text=" — " />
                    <Run Text="{Binding RecoveryDiagnostic, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Top"
                Padding="20,7"
                Background="{StaticResource Accent100Brush}"
                BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="0,0,0,1"
                Visibility="{Binding HasProviderReadinessProblem, Converter={StaticResource BoolToVisibility}}"
                AutomationProperties.Name="Provider readiness notice"
                AutomationProperties.AutomationId="Skilly.ProviderReadinessNotice">
            <StackPanel Orientation="Horizontal">
                <Viewbox Width="14" Height="14" Margin="0,0,10,0" VerticalAlignment="Center">
                    <Canvas Width="24" Height="24">
                        <Path Data="M2,12 A10,10 0 1 0 22,12 A10,10 0 1 0 2,12 M12,16 v-4 M12,8 h0.01"
                              Stroke="{StaticResource Accent900Brush}"
                              StrokeThickness="1.5"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" />
                    </Canvas>
                </Viewbox>
                <TextBlock FontSize="12.5"
                           Foreground="{StaticResource Accent900Brush}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Text="{Binding ProviderReadiness}" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Top" Padding="20,8" Background="{StaticResource Accent100Brush}"
                Visibility="{Binding MaintenanceBusy, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource RowActionButton}" Content="Stop after current operation" Click="OnStopUpdates" Margin="12,0,0,0" AutomationProperties.AutomationId="Skilly.StopUpdates" />
                <ProgressBar Style="{StaticResource IndustryProgress}" DockPanel.Dock="Left" Width="140" Height="8" Margin="0,0,12,0" Maximum="{Binding ProgressMaximum}" Value="{Binding ProgressValue}" />
                <TextBlock Text="{Binding OperationProgress}" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.AutomationId="Skilly.UpdateProgress" />
            </DockPanel>
        </Border>

        <!-- ═══ Status bar ═══ -->
        <StatusBar DockPanel.Dock="Bottom"
                   Background="Transparent"
                   BorderBrush="{StaticResource DividerBrush}"
                   BorderThickness="0,1,0,0"
                   Padding="20,3"
                   AutomationProperties.Name="Operation status"
                   AutomationProperties.AutomationId="OperationStatusBar">
            <StatusBarItem HorizontalContentAlignment="Stretch" Padding="0">
                <DockPanel>
                    <Rectangle DockPanel.Dock="Left"
                               Width="7"
                               Height="7"
                               Fill="{StaticResource AccentBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0" />
                    <TextBlock DockPanel.Dock="Right"
                               Text="{Binding Status.Timestamp, StringFormat='HH:mm:ss'}"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="12"
                               Foreground="{StaticResource Text45Brush}"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0" />
                    <TextBlock x:Name="StatusMessage"
                               Text="{Binding Status.Message}"
                               FontSize="12"
                               Foreground="{StaticResource Text65Brush}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               AutomationProperties.Name="{Binding Status.Message}"
                               AutomationProperties.AutomationId="Skilly.StatusMessage"
                               AutomationProperties.LiveSetting="Polite" />
                </DockPanel>
            </StatusBarItem>
        </StatusBar>

        <!-- ═══ Content row ═══ -->
        <Grid Margin="20,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="{Binding DetailsGap}" />
                <ColumnDefinition Width="{Binding DetailsWidth}" />
            </Grid.ColumnDefinitions>

            <!-- Skills list -->
            <ContentControl Grid.Column="0" Style="{StaticResource BlueprintPanel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <WrapPanel Grid.Row="0" Margin="14,12,14,4">
                    <ListBox x:Name="FilterRail"
                             ItemsSource="{Binding Filters}"
                             SelectedItem="{Binding SelectedFilter, Mode=TwoWay}"
                             Background="Transparent" Margin="0,0,12,8"
                             BorderThickness="1,1,0,1" BorderBrush="{StaticResource DividerBrush}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             AutomationProperties.Name="Inventory filters"
                             AutomationProperties.AutomationId="Skilly.FilterRail"
                             TabIndex="5">
                        <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource FilterSegment}">
                                <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right"
                                               Text="{Binding Count}"
                                               FontFamily="{StaticResource MonoFont}"
                                               FontSize="10.5"
                                               FontWeight="Normal"
                                               Opacity="0.65"
                                               VerticalAlignment="Center"
                                               Margin="8,0,0,0" />
                                    <TextBlock Text="{Binding Name}" FontSize="12.5" VerticalAlignment="Center" />
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                        <StackPanel
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="0,0,12,8">
                            <CheckBox Style="{StaticResource IndustryCheckBox}"
                                      IsChecked="{Binding GroupByLibrary, Mode=TwoWay}"
                                      AutomationProperties.Name="Group by Skill Library"
                                      AutomationProperties.AutomationId="Skilly.GroupByLibrary"
                                      TabIndex="7" />
                            <TextBlock Text="Group by Library"
                                       FontSize="11.5"
                                       Foreground="{StaticResource Text60Brush}"
                                       VerticalAlignment="Center"
                                       Margin="7,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding ListSummary}"
                                   FontSize="11.5"
                                   Foreground="{StaticResource Text45Brush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,8" />
                        <Grid  Width="220" MaxWidth="240" Margin="0,0,0,8">
                            <TextBox x:Name="SearchBox"
                                     Style="{StaticResource IndustryTextBox}"
                                     MinHeight="31"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Search skills"
                                     AutomationProperties.AutomationId="Skilly.Search"
                                     TabIndex="6" />
                            <TextBlock Text="Search skills"
                                       Margin="10,0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource Text45Brush}"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </WrapPanel>

                    <ScrollViewer Grid.Row="1" Grid.RowSpan="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                    <Grid MinWidth="{Binding InventoryMinimumWidth}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Border Grid.Row="0"
                            BorderBrush="{StaticResource DividerBrush}"
                            BorderThickness="0,1,0,1"
                            Padding="14,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding DataContext.SkillColumnWidth, RelativeSource={RelativeSource AncestorType=Window}}" MinWidth="160" />
                                <ColumnDefinition Width="{Binding DataContext.ManagementWidth, RelativeSource={RelativeSource AncestorType=Window}}" />
                                <ColumnDefinition Width="{Binding DataContext.StatusWidth, RelativeSource={RelativeSource AncestorType=Window}}" />
                                <ColumnDefinition Width="{Binding DataContext.ExposuresWidth, RelativeSource={RelativeSource AncestorType=Window}}" />
                                <ColumnDefinition Width="{Binding DataContext.ActionWidth, RelativeSource={RelativeSource AncestorType=Window}}" />
                            </Grid.ColumnDefinitions>
                            <Thumb Grid.Column="0" Style="{StaticResource ColumnResizeThumb}" Width="6" HorizontalAlignment="Right" Cursor="SizeWE" DragDelta="OnResizeColumn" Background="{StaticResource DividerBrush}" Panel.ZIndex="2" AutomationProperties.Name="Resize Skill column" />
                            <Thumb Grid.Column="1" Style="{StaticResource ColumnResizeThumb}" Width="6" HorizontalAlignment="Right" Cursor="SizeWE" DragDelta="OnResizeColumn" Background="{StaticResource DividerBrush}" Panel.ZIndex="2" AutomationProperties.Name="Resize Management column" />
                            <Thumb Grid.Column="2" Style="{StaticResource ColumnResizeThumb}" Width="6" HorizontalAlignment="Right" Cursor="SizeWE" DragDelta="OnResizeColumn" Background="{StaticResource DividerBrush}" Panel.ZIndex="2" AutomationProperties.Name="Resize Status column" />
                            <Thumb Grid.Column="3" Style="{StaticResource ColumnResizeThumb}" Width="6" HorizontalAlignment="Right" Cursor="SizeWE" DragDelta="OnResizeColumn" Background="{StaticResource DividerBrush}" Panel.ZIndex="2" AutomationProperties.Name="Resize Exposures column" />
                            <Thumb Grid.Column="4" Style="{StaticResource ColumnResizeThumb}" Width="6" HorizontalAlignment="Right" Cursor="SizeWE" DragDelta="OnResizeColumn" Background="{StaticResource DividerBrush}" Panel.ZIndex="2" AutomationProperties.Name="Resize Action column" />
                            <Button Grid.Column="0" Style="{StaticResource SortHeaderButton}" Content="{Binding NameHeader}" Tag="Name" Click="OnSortHeaderClick" />
                            <Button Grid.Column="1" Style="{StaticResource SortHeaderButton}" Content="{Binding ManagementHeader}" Tag="Management" Click="OnSortHeaderClick" />
                            <Button Grid.Column="2" Style="{StaticResource SortHeaderButton}" Content="{Binding StatusHeader}" Tag="Status" Click="OnSortHeaderClick" ToolTip="Sort deviations first. Right-click for Health or Update sorting.">
                                <Button.ContextMenu><ContextMenu>
                                    <MenuItem Header="Sort by Status" Tag="Status" Click="OnSortHeaderClick" />
                                    <MenuItem Header="Sort by Health" Tag="Health" Click="OnSortHeaderClick" />
                                    <MenuItem Header="Sort by Update" Tag="UpdateStatus" Click="OnSortHeaderClick" />
                                </ContextMenu></Button.ContextMenu>
                            </Button>
                            <Button Grid.Column="3" Style="{StaticResource SortHeaderButton}" Content="{Binding ExposuresHeader}" Tag="Exposures" Click="OnSortHeaderClick" />

                        </Grid>
                    </Border>

                    <ListBox Grid.Row="1"
                             x:Name="SkillList"
                             ItemsSource="{Binding Rows}"
                             SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                             SelectionMode="Extended"
                             SelectionChanged="OnSkillListSelectionChanged"
                             PreviewMouseLeftButtonDown="OnSkillListMouseDown"
                             Background="Transparent"
                             BorderThickness="0"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             ItemContainerStyleSelector="{StaticResource SkillListContainerSelector}"
                             AutomationProperties.Name="Skill list"
                             AutomationProperties.AutomationId="Skilly.SkillList"
                             TabIndex="8">
                        <ListBox.Resources>
                            <DataTemplate DataType="{x:Type vm:InventoryRow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{Binding DataContext.SkillColumnWidth, RelativeSource={RelativeSource AncestorType=Window}}" MinWidth="160" />
                                <ColumnDefinition Width="{Binding DataContext.ManagementWidth, RelativeSource={RelativeSource AncestorType=Window}}" />
                                <ColumnDefinition Width="{Binding DataContext.StatusWidth, RelativeSource={RelativeSource AncestorType=Window}}" />
                                <ColumnDefinition Width="{Binding DataContext.ExposuresWidth, RelativeSource={RelativeSource AncestorType=Window}}" />
                                <ColumnDefinition Width="{Binding DataContext.ActionWidth, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="{Binding DataContext.MemberIndent, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <TextBlock Text="{Binding Name}"
                                                   FontWeight="SemiBold"
                                                   FontSize="13.5"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding RootLabel}"
                                                   FontFamily="{StaticResource MonoFont}"
                                                   FontSize="10.5"
                                                   Foreground="{StaticResource Text50Brush}"
                                                   Margin="0,1,0,0" />
                                    </StackPanel>
                                    <ContentControl Grid.Column="1" Content="{Binding}" ContentTemplate="{StaticResource ManagementTag}" Focusable="False" Margin="0,0,8,0" />
                                    <ContentControl Grid.Column="2" Content="{Binding}" ContentTemplate="{StaticResource StatusCell}" Focusable="False" Margin="0,0,8,0" />
                                    <StackPanel Grid.Column="4" HorizontalAlignment="Right" VerticalAlignment="Center" IsEnabled="{Binding DataContext.MutationsAllowed, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <Button Content="Update" Style="{StaticResource RowActionButton}" Click="OnRowUpdate" Visibility="{Binding CanUpdate, Converter={StaticResource BoolToVisibility}}" AutomationProperties.AutomationId="Skilly.RowUpdate" AutomationProperties.Name="{Binding Name, StringFormat=Update {0}}" />
                                        <Button Content="Adopt" Style="{StaticResource RowActionButton}" Click="OnRowAdopt" Visibility="{Binding CanAdopt, Converter={StaticResource BoolToVisibility}}" AutomationProperties.AutomationId="Skilly.RowAdopt" AutomationProperties.Name="{Binding Name, StringFormat=Adopt {0}}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ItemsControl ItemsSource="{Binding ExposureCells}" Focusable="False" VerticalAlignment="Center">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Rectangle x:Name="Cell"
                                                               Width="9"
                                                               Height="9"
                                                               Margin="0,0,3,0"
                                                               Stroke="{StaticResource Accent700Brush}"
                                                               StrokeThickness="1"
                                                               Fill="Transparent"
                                                               Opacity="0.3" />
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding}" Value="True">
                                                            <Setter TargetName="Cell" Property="Fill" Value="{StaticResource AccentBrush}" />
                                                            <Setter TargetName="Cell" Property="Opacity" Value="1" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{Binding ExposuresLabel}"
                                                   FontFamily="{StaticResource MonoFont}"
                                                   FontSize="11.5"
                                                   Foreground="{StaticResource Text55Brush}"
                                                   VerticalAlignment="Center"
                                                   Margin="5,0,0,0" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>

                            <!-- Skill Library root row: click toggles the tree, the action button updates the whole library. -->
                            <DataTemplate DataType="{x:Type vm:LibraryGroupRow}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right"
                                            Style="{StaticResource GhostButton}"
                                            FontFamily="{StaticResource BodyFont}" Foreground="{StaticResource Accent700Brush}"
                                            FontSize="12"
                                            Margin="8,3,10,3"
                                            VerticalAlignment="Center"
                                            Click="OnUpdateLibrary"
                                            IsEnabled="{Binding DataContext.MutationsAllowed, RelativeSource={RelativeSource AncestorType=Window}}"
                                            Visibility="{Binding CanUpdateLibrary, Converter={StaticResource BoolToVisibility}}"
                                            AutomationProperties.Name="{Binding Label, StringFormat='Update Skill Library {0}'}"
                                            AutomationProperties.AutomationId="Skilly.UpdateLibrary">
                                        <StackPanel Orientation="Horizontal">
                                            <Viewbox Width="12" Height="12" Margin="0,0,6,0">
                                                <Canvas Width="24" Height="24">
                                                    <Path Data="M21,15 v4 a2,2 0 0 1 -2,2 H5 a2,2 0 0 1 -2,-2 v-4 M7,10 l5,5 5,-5 M12,15 V3"
                                                          Stroke="{StaticResource AccentBrush}"
                                                          StrokeThickness="1.5"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"
                                                          StrokeLineJoin="Round" />
                                                </Canvas>
                                            </Viewbox>
                                            <TextBlock Text="{Binding UpdatableCount, StringFormat='Update Library ({0})'}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <ToggleButton IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                                  Cursor="Hand"
                                                  FocusVisualStyle="{StaticResource IndustryFocusVisual}"
                                                  HorizontalAlignment="Stretch"
                                                  HorizontalContentAlignment="Stretch"
                                                  AutomationProperties.Name="{Binding AutomationName}"
                                                  AutomationProperties.AutomationId="Skilly.LibraryGroup">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent" Padding="14,8">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path x:Name="Chevron"
                                                              Data="M9,6 L15,12 L9,18"
                                                              Width="11"
                                                              Height="11"
                                                              Stretch="Uniform"
                                                              Stroke="{StaticResource Text60Brush}"
                                                              StrokeThickness="2"
                                                              StrokeStartLineCap="Round"
                                                              StrokeEndLineCap="Round"
                                                              StrokeLineJoin="Round"
                                                              VerticalAlignment="Center"
                                                              RenderTransformOrigin="0.5,0.5"
                                                              Margin="0,0,10,0">
                                                            <Path.RenderTransform>
                                                                <RotateTransform Angle="0" />
                                                            </Path.RenderTransform>
                                                        </Path>
                                                        <TextBlock Text="{Binding Label}"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="13"
                                                                   VerticalAlignment="Center" />
                                                        <Border Background="{StaticResource Neutral100Brush}"
                                                                CornerRadius="3"
                                                                Margin="10,0,0,0"
                                                                VerticalAlignment="Center"
                                                                Visibility="{Binding HasProviderLabel, Converter={StaticResource BoolToVisibility}}">
                                                            <TextBlock Margin="8,2"
                                                                       FontSize="10.5"
                                                                       Foreground="{StaticResource Neutral800Brush}"
                                                                       Text="{Binding ProviderLabel}" />
                                                        </Border>
                                                        <TextBlock Text="{Binding CountLabel}"
                                                                   FontSize="11.5"
                                                                   Foreground="{StaticResource Text50Brush}"
                                                                   VerticalAlignment="Center"
                                                                   Margin="10,0,0,0" />
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="Chevron" Property="RenderTransform">
                                                            <Setter.Value>
                                                                <RotateTransform Angle="90" />
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.Resources>
                    </ListBox>

                    <TextBlock Grid.Row="1"
                               Text="No Skills found yet. Global installations will appear here."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="13"
                               Foreground="{StaticResource Text50Brush}"
                               IsHitTestVisible="False"
                               Visibility="{Binding HasNoSkills, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Grid.Row="1"
                               Text="No Skills match this filter."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="13"
                               Foreground="{StaticResource Text50Brush}"
                               IsHitTestVisible="False"
                               Visibility="{Binding HasNoMatches, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                    </ScrollViewer>
                </Grid>
            </ContentControl>

            <Thumb Grid.Column="1" Cursor="SizeWE" DragDelta="OnResizeDetails" Background="Transparent"
                   Visibility="{Binding ShowDetails, Converter={StaticResource BoolToVisibility}}"
                   AutomationProperties.Name="Resize details pane" />
            <!-- Details pane -->
            <ContentControl Grid.Column="2" Style="{StaticResource BlueprintPanel}" Visibility="{Binding ShowDetails, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Style="{StaticResource Kicker}"
                               Text="SKILL DETAILS"
                               Margin="16,14,16,6" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  AutomationProperties.Name="Skill details"
                                  AutomationProperties.AutomationId="Skilly.DetailsPane"
                                  Focusable="False">
                        <StackPanel Margin="16,0,16,16">
                            <TextBlock Text="Select a Skill to inspect its metadata, statuses, and Harness Exposures."
                                       FontSize="12.5"
                                       Foreground="{StaticResource Text50Brush}"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0"
                                       Visibility="{Binding HasNoSelection, Converter={StaticResource BoolToVisibility}}" />

                            <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding SelectedRow.RootLabel}" FontFamily="{StaticResource MonoFont}" FontSize="10.5" Foreground="{StaticResource Text50Brush}" Margin="0,3,0,3" />
                                <TextBlock Text="{Binding SelectedRow.Name}"
                                           FontFamily="{StaticResource HeadingFont}"
                                           FontWeight="SemiBold"
                                           FontSize="30"
                                           TextWrapping="Wrap"
                                           LineHeight="30"
                                           LineStackingStrategy="BlockLineHeight" />
                                <WrapPanel Margin="0,8,0,0">
                                    <ContentControl Content="{Binding SelectedRow}" ContentTemplate="{StaticResource ManagementTagFull}" Focusable="False" Margin="0,0,6,4" />
                                    <ContentControl Content="{Binding SelectedRow}" ContentTemplate="{StaticResource HealthTagDetail}" Focusable="False" Margin="0,0,6,4" />
                                    <ContentControl Content="{Binding SelectedRow}" ContentTemplate="{StaticResource UpdateTagDetail}" Focusable="False" Margin="0,0,6,4" />
                                </WrapPanel>
                                <TextBlock Text="{Binding SelectedRow.Entry.Metadata.Description}"
                                           FontSize="12.5"
                                           Foreground="{StaticResource Text75Brush}"
                                           TextWrapping="Wrap"
                                           LineHeight="19.4"
                                           LineStackingStrategy="BlockLineHeight"
                                           Margin="0,10,0,0" />

                                <WrapPanel Margin="-8,8,-8,0">
                                    <Button Content="Open _folder" Click="OnOpenSkillFolder" IsEnabled="{Binding SelectedRow.CanOpenFolder}"
                                            Style="{StaticResource QuickActionButton}" AutomationProperties.AutomationId="Skilly.OpenFolder" />
                                    <Button Content="Open _source" Click="OnOpenSkillSource" IsEnabled="{Binding SelectedRow.CanOpenSource}"
                                            ToolTip="Open the recorded HTTPS source in your browser, when available."
                                            Style="{StaticResource QuickActionButton}" AutomationProperties.AutomationId="Skilly.OpenSource" />
                                    <Button Content="Copy _path" Click="OnCopySkillPath"
                                            Style="{StaticResource QuickActionButton}" AutomationProperties.AutomationId="Skilly.CopyPath" />
                                    <Button Content="Read SKILL._md" Click="OnReadSkillMarkdown" IsEnabled="{Binding SelectedRow.CanReadSkillMarkdown}"
                                            Style="{StaticResource QuickActionButton}" AutomationProperties.AutomationId="Skilly.ReadSkillMarkdown" />
                                </WrapPanel>

                                <Border Style="{StaticResource SectionHeader}"><TextBlock Style="{StaticResource SectionKicker}" Text="HARNESS EXPOSURES" /></Border>
                                <ItemsControl ItemsSource="{Binding SelectedRow.ExposureRows}" Focusable="False" AutomationProperties.AutomationId="Skilly.ExposureDiagram">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate><DataTemplate>
                                        <StackPanel Margin="0,0,6,0" ToolTip="{Binding Detail}" AutomationProperties.Name="{Binding Harness}">
                                            <Grid Height="44" x:Name="Cell" Opacity="0.4">
                                                <Rectangle x:Name="CellBg" Fill="Transparent" Stroke="{StaticResource Accent700Brush}" StrokeThickness="1" />
                                                <TextBlock x:Name="CellText" Text="{Binding Abbreviation}" FontFamily="{StaticResource HeadingFont}" FontWeight="SemiBold" FontSize="16" Foreground="{StaticResource Accent700Brush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Grid>
                                            <TextBlock Text="{Binding Label}" FontSize="10" Foreground="{StaticResource Text60Brush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsExposed}" Value="True">
                                                <Setter TargetName="Cell" Property="Opacity" Value="1" /><Setter TargetName="CellBg" Property="Fill" Value="{StaticResource AccentBrush}" /><Setter TargetName="CellText" Property="Foreground" Value="{StaticResource BgBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HasProblem}" Value="True">
                                                <Setter TargetName="Cell" Property="Opacity" Value="1" /><Setter TargetName="CellBg" Property="Fill" Value="{StaticResource Accent900Brush}" />
                                                <Setter TargetName="CellBg" Property="Stroke" Value="{StaticResource Accent900Brush}" /><Setter TargetName="CellBg" Property="StrokeDashArray" Value="3 2" />
                                                <Setter TargetName="CellText" Property="Foreground" Value="{StaticResource BgBrush}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl ItemsSource="{Binding SelectedRow.ExposureRows}" Focusable="False">
                                    <ItemsControl.ItemTemplate><DataTemplate>
                                        <TextBlock Text="{Binding Detail}" FontSize="11.5" Foreground="{StaticResource Accent800Brush}" TextWrapping="Wrap" Margin="0,5,0,0" Visibility="{Binding HasProblem, Converter={StaticResource BoolToVisibility}}" />
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border Style="{StaticResource SectionHeader}">
                                    <TextBlock Style="{StaticResource SectionKicker}" Text="PROVENANCE" />
                                </Border>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="104" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource DetailLabel}" Text="Library" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource DetailValue}" Text="{Binding SelectedRow.LibraryDetail}" />
                                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource DetailLabel}" Text="Provenance" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource DetailValue}" Text="{Binding SelectedRow.Provenance}" />
                                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource DetailLabel}" Text="Source" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource DetailValueMono}" Text="{Binding SelectedRow.Source}" />
                                    <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource DetailLabel}" Text="Skill path" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource DetailValueMono}" Text="{Binding SelectedRow.SourceSkillPath}" />
                                    <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource DetailLabel}" Text="Tracking Rule" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource DetailValue}" Text="{Binding SelectedRow.TrackingRule}" />
                                    <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource DetailLabel}" Text="Installed rev" />
                                    <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource DetailValueMono}" Text="{Binding SelectedRow.InstalledRevision}" />
                                    <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource DetailLabel}" Text="Available rev" />
                                    <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource DetailValueMono}" Text="{Binding SelectedRow.AvailableRevision}" />
                                    <TextBlock Grid.Row="7" Grid.Column="0" Style="{StaticResource DetailLabel}" Text="Last checked" />
                                    <TextBlock Grid.Row="7" Grid.Column="1" Style="{StaticResource DetailValueMono}" Text="{Binding SelectedRow.LastChecked}" />
                                </Grid>

                                <Border Style="{StaticResource SectionHeader}">
                                    <TextBlock Style="{StaticResource SectionKicker}" Text="STATUS" />
                                </Border>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource DetailLabel}" Text="Health" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource DetailValue}" Text="{Binding SelectedRow.Health}" />
                                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                               FontSize="11.5"
                                               Foreground="{StaticResource Text60Brush}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,5"
                                               Text="{Binding SelectedRow.Entry.HealthDetail}" />
                                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource DetailLabel}" Text="Update" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource DetailValue}" Text="{Binding SelectedRow.UpdateStatus}" />
                                    <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                                               FontSize="11.5"
                                               Foreground="{StaticResource Accent800Brush}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,5"
                                               Text="{Binding SelectedRow.CheckNotice}"
                                               Visibility="{Binding SelectedRow.HasCheckNotice, Converter={StaticResource BoolToVisibility}}" />
                                    <Border Grid.Row="4" Grid.ColumnSpan="2" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" Padding="10,8" Margin="0,8,0,0">
                                        <StackPanel><TextBlock Style="{StaticResource SectionKicker}" FontSize="12" Text="NEXT STEP" Margin="0,0,0,4" />
                                            <TextBlock Text="{Binding SelectedRow.ActionState}" FontSize="12" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Border Style="{StaticResource SectionHeader}">
                                    <TextBlock Style="{StaticResource SectionKicker}" Text="ACTIONS" />
                                </Border>
                                <Grid IsEnabled="{Binding MutationsAllowed}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="8" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="8" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Button Grid.Row="0" Grid.Column="0"
                                            Style="{StaticResource ContextActionButton}"
                                            Content="_Adopt Skill"
                                            Click="OnAdoptSelected"
                                            IsEnabled="{Binding CanAdoptSelection}"
                                            AutomationProperties.Name="Adopt exact verified Skills without changing content"
                                            AutomationProperties.AutomationId="Skilly.AdoptSkill" />
                                    <Button Grid.Row="0" Grid.Column="2"
                                            Style="{StaticResource ContextActionButton}"
                                            Content="_Update Skill"
                                            Click="OnUpdateSelected"
                                            IsEnabled="{Binding SelectedRow.CanUpdate}"
                                            AutomationProperties.Name="Update selected Skill"
                                            AutomationProperties.AutomationId="Skilly.UpdateSkill" />
                                    <Button Grid.Row="2" Grid.Column="0"
                                            Style="{StaticResource SecondaryActionButton}"
                                            Content="Managed _Reinstall"
                                            Click="OnManagedReinstallSelected"
                                            IsEnabled="{Binding SelectedRow.CanManagedReinstall}"
                                            AutomationProperties.Name="Managed Reinstall selected Skill"
                                            AutomationProperties.AutomationId="Skilly.ManagedReinstall" />
                                    <Button Grid.Row="2" Grid.Column="2"
                                            Style="{StaticResource SecondaryActionButton}"
                                            Content="_Uninstall"
                                            Click="OnUninstallSelected"
                                            IsEnabled="{Binding SelectedRow.CanUninstall}"
                                            AutomationProperties.Name="Uninstall Healthy Managed Skill"
                                            AutomationProperties.AutomationId="Skilly.UninstallSkill" />
                                    <Button Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
                                            Style="{StaticResource SecondaryActionButton}"
                                            Content="Remove Local _Folder"
                                            Click="OnRemoveLocalFolderSelected"
                                            IsEnabled="{Binding SelectedRow.CanRemoveLocalFolder}"
                                            AutomationProperties.Name="Remove Local Folder for Unmanaged Installation"
                                            AutomationProperties.AutomationId="Skilly.RemoveLocalFolder" />
                                </Grid>

                                <Border Style="{StaticResource SectionHeader}">
                                    <TextBlock Style="{StaticResource SectionKicker}" Text="LOCAL PATH" />
                                </Border>
                                <TextBlock Text="{Binding SelectedRow.Entry.LocalPath, Mode=OneWay}"
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="11"
                                           Opacity="0.85"
                                           TextWrapping="Wrap"
                                           AutomationProperties.Name="Exact local path" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </ContentControl>
        </Grid>
    </DockPanel>
    </Border>
</Window>

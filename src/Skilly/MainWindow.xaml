<Window x:Class="Skilly.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Skilly"
        Width="1180"
        Height="740"
        MinWidth="900"
        MinHeight="560"
        AutomationProperties.Name="Skilly Workbench">
    <Window.Resources>
        <Style x:Key="PaneHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Foreground" Value="#444444" />
        </Style>
        <Style x:Key="DetailLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,6,0,2" />
            <Setter Property="Foreground" Value="#555555" />
        </Style>
        <Style x:Key="DetailValue" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="#1B1B1B" />
        </Style>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top"
                Padding="12,10"
                Background="#F2F2F2"
                BorderBrush="#D0D0D0"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           x:Name="SourceLabel"
                           Text="_Skill source:"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0" />
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding SourceProviders}"
                          SelectedItem="{Binding SelectedSourceProvider, Mode=TwoWay}"
                          AutomationProperties.Name="Source provider"
                          Margin="0,0,8,0"
                          TabIndex="0" />
                <TextBox Grid.Column="2"
                         x:Name="SourceBox"
                         Text="{Binding SourceText, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Skill source URL or reference"
                         AutomationProperties.LabeledBy="{Binding ElementName=SourceLabel}"
                         VerticalContentAlignment="Center"
                         Margin="0,0,8,0"
                          TabIndex="1" />
                <Button Grid.Column="3"
                        x:Name="InspectSourceButton"
                        Content="_Inspect source"
                        Click="OnInspectSource"
                        Margin="0,0,8,0"
                        MinWidth="110"
                         TabIndex="2" />
                <Button Grid.Column="4"
                        x:Name="RefreshChecksButton"
                        Content="_Refresh checks"
                        Click="OnRefreshChecks"
                        MinWidth="110"
                         TabIndex="3" />
            </Grid>
        </Border>

        <Border DockPanel.Dock="Top"
                Padding="12,8"
                Background="#FFF2CC"
                BorderBrush="#B7791F"
                BorderThickness="0,0,0,1"
                Visibility="{Binding RecoveryRequired, Converter={StaticResource BoolToVisibility}}"
                AutomationProperties.Name="Recovery Required read-only notice">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Recovery Required: " FontWeight="Bold" />
                <TextBlock Text="{Binding RecoveryDiagnostic}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Top"
                Padding="12,8"
                Background="#FFF7E6"
                BorderBrush="#B7791F"
                BorderThickness="0,0,0,1"
                Visibility="{Binding HasProviderReadinessProblem, Converter={StaticResource BoolToVisibility}}"
                AutomationProperties.Name="Provider readiness notice">
            <TextBlock Text="{Binding ProviderReadiness}" TextWrapping="Wrap" />
        </Border>

        <StatusBar DockPanel.Dock="Bottom"
                   AutomationProperties.Name="Operation status"
                   AutomationProperties.AutomationId="OperationStatusBar">
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="StatusMessage"
                               Text="{Binding Status.Message}"
                               AutomationProperties.Name="Last operation result"
                               AutomationProperties.LiveSetting="Polite"
                               Margin="0,0,12,0" />
                    <TextBlock Text="{Binding Status.Timestamp, StringFormat='HH:mm:ss'}"
                               Foreground="#777777" />
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Margin="0,0,12,0"
                    BorderBrush="#D0D0D0"
                    BorderThickness="1"
                    CornerRadius="4">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Style="{StaticResource PaneHeader}"
                               Text="Filters"
                               Margin="8,8,8,4" />
                    <ListBox x:Name="FilterRail"
                             ItemsSource="{Binding Filters}"
                             SelectedItem="{Binding SelectedFilter, Mode=TwoWay}"
                             DisplayMemberPath="Name"
                             AutomationProperties.Name="Inventory filters"
                             AutomationProperties.AutomationId="Skilly.FilterRail"
                             BorderThickness="0"
                             TabIndex="3" />
                </DockPanel>
            </Border>

            <Border Grid.Column="1"
                    Margin="0,0,12,0"
                    BorderBrush="#D0D0D0"
                    BorderThickness="1"
                    CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Style="{StaticResource PaneHeader}"
                               Text="Skills"
                               Margin="8,8,8,4" />
                    <DockPanel Grid.Row="1" Margin="8,0,8,6">
                        <TextBlock DockPanel.Dock="Left"
                                   x:Name="SearchLabel"
                                   Text="_Search:"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0" />
                        <TextBox x:Name="SearchBox"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Search skills"
                                 AutomationProperties.LabeledBy="{Binding ElementName=SearchLabel}"
                                 VerticalContentAlignment="Center"
                                 TabIndex="4" />
                    </DockPanel>
                    <ListView Grid.Row="2"
                              x:Name="SkillList"
                              ItemsSource="{Binding Rows}"
                              SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                              AutomationProperties.Name="Skill list"
                              AutomationProperties.AutomationId="Skilly.SkillList"
                              BorderThickness="0"
                              TabIndex="5"
                              GridViewColumnHeader.Click="OnSkillListHeaderClick">
                        <ListView.View>
                            <GridView AllowsColumnReorder="True">
                                <GridViewColumn Header="Skill" Width="140" DisplayMemberBinding="{Binding Name}" />
                                <GridViewColumn Header="Root" Width="130" DisplayMemberBinding="{Binding RootLabel}" />
                                <GridViewColumn Header="Management" Width="100" DisplayMemberBinding="{Binding Management}" />
                                <GridViewColumn Header="Health" Width="120" DisplayMemberBinding="{Binding Health}" />
                                <GridViewColumn Header="Update" Width="90" DisplayMemberBinding="{Binding UpdateStatus}" />
                                <GridViewColumn Header="Exposures" Width="150" DisplayMemberBinding="{Binding ExposuresSummary}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <TextBlock Grid.Row="2"
                               Text="No Skills found yet. Global installations will appear here."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="#888888"
                               IsHitTestVisible="False"
                               Visibility="{Binding HasNoSkills, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    BorderBrush="#D0D0D0"
                    BorderThickness="1"
                    CornerRadius="4">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              AutomationProperties.Name="Skill details"
                              AutomationProperties.AutomationId="Skilly.DetailsPane"
                              Focusable="False">
                    <StackPanel Margin="10,8,10,12">
                        <TextBlock Style="{StaticResource PaneHeader}" Text="{Binding DetailsHeader}" />
                        <TextBlock Text="Select a Skill to inspect its metadata, statuses, and Harness Exposures."
                                   Foreground="#888888"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding HasNoSelection, Converter={StaticResource BoolToVisibility}}" />

                        <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource DetailLabel}" Text="Description" />
                            <TextBlock Style="{StaticResource DetailValue}" Text="{Binding SelectedRow.Entry.Metadata.Description}" />
                            <TextBlock Style="{StaticResource DetailLabel}" Text="Declared name" />
                            <TextBlock Style="{StaticResource DetailValue}" Text="{Binding SelectedRow.DisplayName}" />
                            <TextBlock Style="{StaticResource DetailLabel}" Text="Provenance" />
                            <TextBlock Style="{StaticResource DetailValue}" Text="{Binding SelectedRow.Provenance}" />
                            <TextBlock Style="{StaticResource DetailLabel}" Text="Source" />
                            <TextBlock Style="{StaticResource DetailValue}" Text="{Binding SelectedRow.Source}" />
                            <TextBlock Style="{StaticResource DetailLabel}" Text="Source Skill path" />
                            <TextBlock Style="{StaticResource DetailValue}" Text="{Binding SelectedRow.SourceSkillPath}" />
                            <TextBlock Style="{StaticResource DetailLabel}" Text="Tracking Rule" />
                            <TextBlock Style="{StaticResource DetailValue}" Text="{Binding SelectedRow.TrackingRule}" />
                            <TextBlock Style="{StaticResource DetailLabel}" Text="Management Status" />
                            <TextBlock Style="{StaticResource DetailValue}" Text="{Binding SelectedRow.Management}" />
                            <TextBlock Style="{StaticResource DetailLabel}" Text="Installation Health" />
                            <TextBlock Style="{StaticResource DetailValue}">
                                <Run Text="{Binding SelectedRow.Health, Mode=OneWay}" /><LineBreak />
                                <Run Text="{Binding SelectedRow.Entry.HealthDetail, Mode=OneWay}" Foreground="#666666" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource DetailLabel}" Text="Update Status" />
                            <TextBlock Style="{StaticResource DetailValue}" Text="{Binding SelectedRow.UpdateStatus}" />
                            <TextBlock Style="{StaticResource DetailLabel}" Text="Installed revision and Skill date" />
                            <TextBlock Style="{StaticResource DetailValue}" Text="{Binding SelectedRow.InstalledRevision}" />
                            <TextBlock Style="{StaticResource DetailLabel}" Text="Available revision and Skill date" />
                            <TextBlock Style="{StaticResource DetailValue}" Text="{Binding SelectedRow.AvailableRevision}" />
                            <TextBlock Style="{StaticResource DetailLabel}" Text="Last checked" />
                            <TextBlock Style="{StaticResource DetailValue}" Text="{Binding SelectedRow.LastChecked}" />
                            <TextBlock Style="{StaticResource DetailValue}"
                                       Text="{Binding SelectedRow.CheckNotice}"
                                       Foreground="#8A4B08"
                                       Visibility="{Binding SelectedRow.HasCheckNotice, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Style="{StaticResource DetailLabel}" Text="Available action" />
                            <TextBlock Style="{StaticResource DetailValue}" Text="{Binding SelectedRow.ActionState}" />
                            <StackPanel IsEnabled="{Binding MutationsAllowed}">
                                <Button Content="_Adopt Skill"
                                        Click="OnAdoptSelected"
                                        IsEnabled="{Binding SelectedRow.CanAdopt}"
                                        HorizontalAlignment="Left"
                                        MinWidth="110"
                                        Margin="0,2,0,6"
                                        AutomationProperties.Name="Adopt exact verified Skill without changing content"
                                        AutomationProperties.AutomationId="Skilly.AdoptSkill" />
                                <Button Content="_Update Skill"
                                        Click="OnUpdateSelected"
                                        IsEnabled="{Binding SelectedRow.CanUpdate}"
                                        HorizontalAlignment="Left"
                                        MinWidth="110"
                                        Margin="0,2,0,6"
                                        AutomationProperties.Name="Update selected Skill" />
                                <Button Content="Managed _Reinstall"
                                        Click="OnManagedReinstallSelected"
                                        IsEnabled="{Binding SelectedRow.CanManagedReinstall}"
                                        HorizontalAlignment="Left"
                                        MinWidth="130"
                                        Margin="0,2,0,6"
                                        AutomationProperties.Name="Managed Reinstall selected Skill" />
                                <Button Content="_Uninstall"
                                        Click="OnUninstallSelected"
                                        IsEnabled="{Binding SelectedRow.CanUninstall}"
                                        HorizontalAlignment="Left"
                                        MinWidth="110"
                                        Margin="0,2,0,6"
                                        AutomationProperties.Name="Uninstall Healthy Managed Skill" />
                                <Button Content="Remove Local _Folder"
                                        Click="OnRemoveLocalFolderSelected"
                                        IsEnabled="{Binding SelectedRow.CanRemoveLocalFolder}"
                                        HorizontalAlignment="Left"
                                        MinWidth="150"
                                        Margin="0,2,0,6"
                                        AutomationProperties.Name="Remove Local Folder for Unmanaged Installation" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource DetailLabel}" Text="Local path" />
                            <TextBlock Style="{StaticResource DetailValue}"
                                       Text="{Binding SelectedRow.Entry.LocalPath, Mode=OneWay}"
                                       AutomationProperties.Name="Exact local path" />
                            <TextBlock Style="{StaticResource DetailLabel}" Text="OpenCode" />
                            <TextBlock Style="{StaticResource DetailValue}">
                                <Run Text="{Binding SelectedRow.ExposureDisplay[OpenCode].Display, Mode=OneWay}" />
                                <Run Text=" — " />
                                <Run Text="{Binding SelectedRow.ExposureDisplay[OpenCode].Detail, Mode=OneWay}" Foreground="#666666" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource DetailLabel}" Text="Codex" />
                            <TextBlock Style="{StaticResource DetailValue}">
                                <Run Text="{Binding SelectedRow.ExposureDisplay[Codex].Display, Mode=OneWay}" />
                                <Run Text=" — " />
                                <Run Text="{Binding SelectedRow.ExposureDisplay[Codex].Detail, Mode=OneWay}" Foreground="#666666" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource DetailLabel}" Text="Claude Code" />
                            <TextBlock Style="{StaticResource DetailValue}">
                                <Run Text="{Binding SelectedRow.ExposureDisplay[ClaudeCode].Display, Mode=OneWay}" />
                                <Run Text=" — " />
                                <Run Text="{Binding SelectedRow.ExposureDisplay[ClaudeCode].Detail, Mode=OneWay}" Foreground="#666666" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource DetailLabel}" Text="GitHub Copilot" />
                            <TextBlock Style="{StaticResource DetailValue}">
                                <Run Text="{Binding SelectedRow.ExposureDisplay[GitHubCopilot].Display, Mode=OneWay}" />
                                <Run Text=" — " />
                                <Run Text="{Binding SelectedRow.ExposureDisplay[GitHubCopilot].Detail, Mode=OneWay}" Foreground="#666666" />
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>
